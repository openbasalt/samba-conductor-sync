#!/bin/sh
# %postun of the SELinux policy package (Fedora's
# %selinux_modules_uninstall): on removal, remove the modules, load the
# policy, and relabel what the modules had labeled and is still there
# (configuration and state the administrator keeps), so nothing is left
# with a type that no longer exists.
MODULES="@MODULES@"
[ "$1" -eq 0 ] || exit 0
[ -r /etc/selinux/config ] || exit 0
. /etc/selinux/config
if [ "${SELINUXTYPE:-}" = targeted ]; then
	pre=/var/lib/selinux/targeted/file_contexts.pre
	if /usr/sbin/selinuxenabled; then
		cp -f /etc/selinux/targeted/contexts/files/file_contexts "$pre"
	fi
	/usr/sbin/semodule -n -X 200 -s targeted -r $MODULES >/dev/null 2>&1 || :
	if /usr/sbin/selinuxenabled; then
		/usr/sbin/load_policy || :
		/usr/sbin/fixfiles -C "$pre" restore >/dev/null 2>&1 || :
		rm -f "$pre"
	fi
fi
exit 0
