#!/bin/sh
# %post of conductor-sync (RPM), as Fedora's %systemd_post: on a fresh
# install the units get their preset state. The distribution's default
# preset disables them (Fedora and Basalt OS: 99-default-disable.preset), so
# nothing is enabled or started: provisioning needs its accounts and a first
# manual apply. systemd's own file triggers reload the manager at the end of
# the transaction.
UNITS="conductor-sync.timer conductor-sync-api.socket"
if [ "$1" -eq 1 ]; then
	if [ -x /usr/lib/systemd/systemd-update-helper ]; then
		/usr/lib/systemd/systemd-update-helper install-system-units $UNITS || :
	else
		systemctl --no-reload preset $UNITS >/dev/null 2>&1 || :
	fi
fi
exit 0
