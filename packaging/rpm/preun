#!/bin/sh
# %preun of conductor-sync (RPM), as Fedora's %systemd_preun: on removal
# (not on upgrade) the units are disabled and stopped.
UNITS="conductor-sync.timer conductor-sync-api.socket conductor-sync-api.service conductor-sync.service"
if [ "$1" -eq 0 ]; then
	if [ -x /usr/lib/systemd/systemd-update-helper ]; then
		/usr/lib/systemd/systemd-update-helper remove-system-units $UNITS || :
	else
		systemctl --no-reload disable --now $UNITS >/dev/null 2>&1 || :
	fi
fi
exit 0
