# conductor-sync management API (`conductor-sync serve`), started by
# conductor-sync-api.socket. Serves conductor only: settings, the Google
# key (write only, stored encrypted), plans and applies as background jobs,
# status and history. Every change is audited with the AD user conductor
# acts for. Scheduled runs stay with conductor-sync.timer.
[Unit]
Description=Samba Conductor provisioning: management API for conductor
Documentation=https://github.com/openbasalt/samba-conductor-sync
Requires=conductor-sync-api.socket
After=network-online.target conductor-sync-api.socket
Wants=network-online.target

[Service]
Type=simple
User=conductor-sync
Group=conductor-sync
ExecStart=/usr/local/bin/conductor-sync serve --config /etc/conductor-sync/conductor-sync.toml
Restart=on-failure
RestartSec=5s

LoadCredential=ad-bind:/etc/conductor-sync/credentials/ad-bind
LoadCredential=state-key:/etc/conductor-sync/credentials/state-key

StateDirectory=conductor-sync
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# PrivateUsers stays off: with a private user namespace the peer of every
# connection would read as "nobody" and the SO_PEERCRED check (only the
# conductor user) would refuse conductor.
PrivateUsers=no
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/conductor-sync
InaccessiblePaths=-/etc/conductor-sync/credentials

[Install]
WantedBy=multi-user.target
