# conductor-sync scheduled run: reads AD with the read-only service account,
# plans, and applies only inside the safety limits (otherwise it stops,
# records the plan as blocked, alerts and exits 3). Started by
# conductor-sync.timer. Manual commands (plan, apply, status, delete-user)
# are run by an administrator as the conductor-sync user:
#   sudo -u conductor-sync conductor-sync plan
[Unit]
Description=Samba Conductor provisioning AD -> Google Workspace
Documentation=https://github.com/openbasalt/samba-conductor-sync
After=network-online.target
Wants=network-online.target
# Chain any notifier on failure (blocked, partial or failed runs exit non-zero):
# OnFailure=notify-admins@%n.service

[Service]
Type=oneshot
User=conductor-sync
Group=conductor-sync
ExecStart=/usr/local/bin/conductor-sync apply --scheduled --config /etc/conductor-sync/conductor-sync.toml
TimeoutStartSec=2h
# Exit 3 (blocked by the limits) and 4 (partial) leave the unit failed, so
# OnFailure= and "systemctl --failed" surface them; the timer still fires.

# The AD bind password and the state key (decrypts the Google service
# account key stored through the management API or `conductor-sync key
# set`), readable only by this service. Names match password_credential and
# api.state_key_credential.
LoadCredential=ad-bind:/etc/conductor-sync/credentials/ad-bind
LoadCredential=state-key:/etc/conductor-sync/credentials/state-key
# A key kept as a file instead (google.key_credential = "google-sa"):
# LoadCredential=google-sa:/etc/conductor-sync/credentials/google-sa
# Optional webhook HMAC key (webhook_secret_credential = "webhook"):
# LoadCredential=webhook:/etc/conductor-sync/credentials/webhook

StateDirectory=conductor-sync
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/conductor-sync
InaccessiblePaths=-/etc/conductor-sync/credentials
# A metrics_file outside the state directory needs write access, e.g.:
# ReadWritePaths=/var/lib/prometheus/node-exporter
